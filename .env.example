LENS_AUTH_SECRET_KEY=
LENS_ADMIN_USERNAME=admin
LENS_ADMIN_PASSWORD=

# Production docker-compose.yml: keep these values aligned. URL-encode special
# characters in the password when placing it in LENS_DATABASE_URL.
LENS_POSTGRES_DB=lens
LENS_POSTGRES_USER=lens
LENS_POSTGRES_PASSWORD=change-me
LENS_DATABASE_URL=postgresql+psycopg://lens:change-me@postgres:5432/lens

# Local development may point directly at an independent external PostgreSQL.
# LENS_DATABASE_URL=postgresql+psycopg://lens:password@127.0.0.1:5432/lens_test
